# Google Maps JavaScript API key (required for the Listings page map).
# Create a key at https://console.cloud.google.com/ and enable "Maps JavaScript API".
# Copy this file to .env.local and set your key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Payload CMS（订单数据库：Supabase Postgres）──
# Supabase → Connect → Direct / Connection string，按用途选择连接方式：
#   · 本地开发 / 执行迁移（npm run migrate）/ Cloudflare「Build variables」
#       → Session pooler（端口 5432）：迁移会建表改表，用会话模式更稳妥；
#         Direct connection 默认只有 IPv6，构建环境不一定连得上
#   · Cloudflare「Variables and Secrets」（Worker 运行时）
#       → Transaction pooler（端口 6543）：适合 serverless，每个请求新开连接、用完即关
#         若日志出现 "prepared statement ... already exists"，改用 Session pooler
#   · 以后接 Cloudflare Hyperdrive：给 Hyperdrive 填 Session pooler（不要叠在 Transaction pooler 上）
# 把 [YOUR-PASSWORD] 换成数据库密码；密码含 @ # / 等特殊字符时需先做 URL 编码
DATABASE_URI=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=

# ── Stripe（在线预订 /book、付尾款 /order）──
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe Dashboard → Webhooks → endpoint 指向 https://<域名>/api/stripe/webhook
# 监听 payment_intent.succeeded / payment_intent.payment_failed / payment_intent.canceled
# 本地：stripe listen --forward-to localhost:3000/api/stripe/webhook（会打印一个 whsec_ 填到这里）
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 网站地址（邮件里的订单链接用；运行时读取）──
SITE_URL=https://thefloralcollections.com
# 订单直达链接的签名密钥（随机长字符串；不填则使用 PAYLOAD_SECRET）
ORDER_LINK_SECRET=

# ── 邮件（Resend：订单确认 / 尾款提醒 / 咨询表单）──
# https://resend.com/api-keys ；发件域名需先在 Resend 验证
RESEND_API_KEY=
EMAIL_FROM=The Floral Collection <orders@thefloralcollections.com>
# 店家收件箱：新订单、咨询表单通知
ADMIN_EMAIL=Contact@thefloralcollections.com

# ── 尾款提醒（每天调用一次）──
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<域名>/api/cron/balance-reminders
CRON_SECRET=
